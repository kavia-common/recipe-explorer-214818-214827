# Example environment variables for the Recipe Explorer frontend (Vite)
# Copy to .env and adjust values as needed. Do not commit actual secrets.

# Network
HOST=0.0.0.0
PORT=3000

# App environment
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_NEXT_TELEMETRY_DISABLED=1

# URLs (non-sensitive examples)
REACT_APP_API_BASE=http://localhost:3000/api
REACT_APP_BACKEND_URL=http://localhost:3000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000

# Other optional flags
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
